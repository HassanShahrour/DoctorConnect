@using DoctorConnect.ViewModels
@model DoctorAvailabilityViewModel
@{
    ViewData["Title"] = "Doctor Availability";
    var clinicColors = new[] { "#2a6b5e", "#c8854c", "#6b4ea8", "#2a5b8b", "#8b2a2a", "#2a7a8b" };
}
<link rel="stylesheet" href="~/css/availability.css" />

<div class="content-page">
    <div class="page-card">
        <div class="page-card__header">
            <h1 class="page-card__title">Doctor <em>Availability</em></h1>
            <span class="avf-header-badge"><i class="fa fa-clock"></i> Weekly Schedule</span>
        </div>
        <div class="page-card__body">
            <form asp-action="SaveAvailability" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="DoctorId" type="hidden" />
                <div class="sched-table-wrap">
                    <table class="sched-table">
                        <thead>
                            <tr class="sched-thead-clinics">
                                <th style="width:140px"></th>
                                @for (int c = 0; c < Model.Clinics.Count; c++)
                                {
                                    var dotColor = clinicColors[c % clinicColors.Length];
                                    <th>
                                        <span class="clinic-header-dot" style="background:@dotColor"></span>
                                        <span class="clinic-header-name">@Model.Clinics[c].ClinicName</span>
                                        <input type="hidden" name="Clinics[@c].ClinicId" value="@Model.Clinics[c].ClinicId" />
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Days.Count; i++)
                            {
                                var dow = Model.Days[i].DayOfWeek;
                                var abbr = dow.ToString().Substring(0, 3).ToUpper();
                                bool isWeekend = dow == DayOfWeek.Saturday || dow == DayOfWeek.Sunday;
                                <tr class="@(isWeekend ? "sched-row--weekend" : "")">
                                    <td>
                                        <div class="sched-day-pill">
                                            <span class="sched-day-abbr">@abbr</span>
                                            <span class="sched-day-full">@dow</span>
                                        </div>
                                        <input type="hidden" name="Days[@i].DayOfWeek" value="@dow" />
                                    </td>
                                    @for (int c = 0; c < Model.Clinics.Count; c++)
                                    {
                                        var cell = Model.Days[i].PerClinicAvailabilities[c];
                                        var accentColor = clinicColors[c % clinicColors.Length];
                                        <td class="sched-td--clinic">
                                            <input type="hidden" name="Days[@i].PerClinicAvailabilities[@c].ClinicId" value="@cell.ClinicId" />
                                            <div class="sched-cell-inner sched-cell @(cell.IsAvailable ? "" : "sched-cell--off")" style="--cell-accent:@accentColor">
                                                <label class="avf-toggle">
                                                    <input name="Days[@i].PerClinicAvailabilities[@c].IsAvailable"
                                                           type="checkbox"
                                                           class="avf-toggle__input availability-checkbox"
                                                           value="true"
                                                           @(cell.IsAvailable ? "checked" : "") />
                                                    <input type="hidden" name="Days[@i].PerClinicAvailabilities[@c].IsAvailable" value="false" />
                                                    <span class="avf-toggle__track">
                                                        <span class="avf-toggle__thumb"></span>
                                                    </span>
                                                    <span class="avf-toggle__text">@(cell.IsAvailable ? "On" : "Off")</span>
                                                </label>
                                                <div class="sched-time-row">
                                                    <div class="sched-time-field">
                                                        <span class="sched-time-label">From</span>
                                                        <input name="Days[@i].PerClinicAvailabilities[@c].StartTime"
                                                               type="time"
                                                               class="sched-input"
                                                               value="@(cell.StartTime?.ToString("hh\\:mm"))" />
                                                    </div>
                                                    <div class="sched-time-field">
                                                        <span class="sched-time-label">To</span>
                                                        <input name="Days[@i].PerClinicAvailabilities[@c].EndTime"
                                                               type="time"
                                                               class="sched-input"
                                                               value="@(cell.EndTime?.ToString("hh\\:mm"))" />
                                                    </div>
                                                    <div class="sched-time-field">
                                                        <span class="sched-time-label">Min</span>
                                                        <input name="Days[@i].PerClinicAvailabilities[@c].DurationInMinutes"
                                                               type="number"
                                                               min="5"
                                                               step="5"
                                                               class="sched-input"
                                                               value="@cell.DurationInMinutes" />
                                                    </div>
                                                </div>
                                                <div id="breaks-list-@i-@c" class="breaks-list">
                                                    @for (int b = 0; b < cell.BreakTimes.Count; b++)
                                                    {
                                                        <div class="break-row">
                                                            <input name="Days[@i].PerClinicAvailabilities[@c].BreakTimes[@b].Start"
                                                                   type="time"
                                                                   class="sched-input"
                                                                   value="@(cell.BreakTimes[b].Start?.ToString("hh\\:mm"))" />
                                                            <span class="break-sep">to</span>
                                                            <input name="Days[@i].PerClinicAvailabilities[@c].BreakTimes[@b].End"
                                                                   type="time"
                                                                   class="sched-input"
                                                                   value="@(cell.BreakTimes[b].End?.ToString("hh\\:mm"))" />
                                                            <button type="button" class="btn-remove-break" title="Remove break">
                                                                x
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                                <button type="button"
                                                        class="add-break"
                                                        data-day="@i"
                                                        data-col="@c">
                                                    <i class="fa fa-plus"></i> Add break
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="avf-footer">
                    <p class="avf-hint">
                        <i class="fa fa-circle-info"></i>
                        Toggle each clinic cell on or off, set working hours and duration per clinic per day. Add break times as needed.
                    </p>
                    <button type="submit" class="avf-submit">
                        <i class="fa fa-floppy-disk"></i> Save Availability
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function(){
            function syncCell(cb){
                const cell=cb.closest('.sched-cell');
                if(!cell)return;
                cell.classList.toggle('sched-cell--off',!cb.checked);
                const label=cell.querySelector('.avf-toggle__text');
                if(label)label.textContent=cb.checked?'On':'Off';
            }
            document.querySelectorAll('.availability-checkbox').forEach(cb=>{
                syncCell(cb);
                cb.addEventListener('change',()=>syncCell(cb));
            });
            document.querySelectorAll('.add-break').forEach(btn=>{
                btn.addEventListener('click',function(){
                    const di=this.dataset.day;
                    const ci=this.dataset.col;
                    const list=document.getElementById('breaks-list-'+di+'-'+ci);
                    const idx=list.querySelectorAll('.break-row').length;
                    const base=`Days[${di}].PerClinicAvailabilities[${ci}].BreakTimes[${idx}]`;
                    const row=document.createElement('div');
                    row.className='break-row';
                    row.innerHTML=`<input name="${base}.Start" type="time" class="sched-input" /><span class="break-sep">to</span><input name="${base}.End" type="time" class="sched-input" /><button type="button" class="btn-remove-break" title="Remove break">x</button>`;
                    list.appendChild(row);
                });
            });
            document.addEventListener('click',function(e){
                const btn=e.target.closest('.btn-remove-break');
                if(btn)btn.closest('.break-row').remove();
            });
        })();
    </script>
}
