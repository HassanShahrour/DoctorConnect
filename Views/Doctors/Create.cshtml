@model DoctorConnect.ViewModels.CreateDoctorViewModel

@{
    ViewData["Title"] = "Create Doctor";
}

<link rel="stylesheet" href="~/css/doctor-form.css" />

<div class="content-page">
    <div class="page-card">
        <div class="page-card__body">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="doctorForm">

                <div class="df-section">
                    <div class="df-section__label">
                        <i class="fa fa-circle-user"></i> Personal Information
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="FirstName" class="df-label"></label>
                                <input asp-for="FirstName" class="df-control" />
                                <span asp-validation-for="FirstName" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="LastName" class="df-label"></label>
                                <input asp-for="LastName" class="df-control" />
                                <span asp-validation-for="LastName" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="Gender" class="df-label"></label>
                                <select asp-for="Gender" class="df-control">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="DateOfBirth" class="df-label"></label>
                                <input asp-for="DateOfBirth" type="date" class="df-control" />
                                <span asp-validation-for="DateOfBirth" class="df-validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="df-section">
                    <div class="df-section__label">
                        <i class="fa fa-address-book"></i> Contact Details
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="Email" class="df-label"></label>
                                <input asp-for="Email" class="df-control" />
                                <span asp-validation-for="Email" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="PhoneNumber" class="df-label"></label>
                                <input asp-for="PhoneNumber" class="df-control" />
                                <span asp-validation-for="PhoneNumber" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="df-field">
                                <label asp-for="Address" class="df-label"></label>
                                <textarea asp-for="Address" rows="2" class="df-control"></textarea>
                                <span asp-validation-for="Address" class="df-validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="df-section">
                    <div class="df-section__label">
                        <i class="fa fa-stethoscope"></i> Professional Details
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="SpecialtyId" class="df-label">Specialty</label>
                                <select asp-for="SpecialtyId" asp-items="Model.Specialities" class="df-control">
                                    <option value="">Select Specialty</option>
                                </select>
                                <span asp-validation-for="SpecialtyId" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label class="df-label">Clinics</label>
                                <button type="button" class="df-btn" data-bs-toggle="modal" data-bs-target="#clinicsModal">
                                    Select Clinics
                                </button>
                                <div id="selectedClinicsList"></div>

                                <!-- Container for generated hidden inputs so model binder gets multiple ClinicIds values -->
                                <div id="ClinicIdsInputs"></div>
                                <!-- legacy/comma value kept for backward compatibility -->
                                <input type="hidden" name="ClinicIdsComma" id="ClinicIdsInput" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="YearsOfExperience" class="df-label"></label>
                                <input asp-for="YearsOfExperience" class="df-control" />
                                <span asp-validation-for="YearsOfExperience" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="ConsultationFee" class="df-label"></label>
                                <input asp-for="ConsultationFee" class="df-control" />
                                <span asp-validation-for="ConsultationFee" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="df-field">
                                <label asp-for="Qualifications" class="df-label"></label>
                                <textarea asp-for="Qualifications" class="df-control"></textarea>
                                <span asp-validation-for="Qualifications" class="df-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="df-field">
                                <label asp-for="Biography" class="df-label"></label>
                                <textarea asp-for="Biography" rows="4" class="df-control"></textarea>
                                <span asp-validation-for="Biography" class="df-validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="df-section">
                    <div class="df-section__label">
                        <i class="fa fa-image"></i> Photo & Status
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="df-field">
                                <label asp-for="ProfilePhoto" class="df-label"></label>
                                <div class="df-photo-wrap">
                                    <div class="df-photo-preview" id="photoPreview">
                                        <i class="fa fa-camera"></i>
                                    </div>
                                    <div class="df-photo-inner">
                                        <input asp-for="ProfilePhoto" type="file" accept="image/*"
                                               class="df-control" id="photoInput" />
                                        <span asp-validation-for="ProfilePhoto" class="df-validation"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="df-field">
                                <label class="df-label">Status</label>
                                <div class="df-toggle-wrap">
                                    <label class="df-toggle">
                                        <input asp-for="IsActive" type="checkbox" class="df-toggle__input" />
                                        <span class="df-toggle__track">
                                            <span class="df-toggle__thumb"></span>
                                        </span>
                                        <span class="df-toggle__text">Active Doctor</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="df-footer">
                    <a asp-action="Index" class="df-btn-back">
                        <i class="fa fa-arrow-left"></i> Back
                    </a>
                    <button type="submit" class="df-btn-save">
                        <i class="fa fa-floppy-disk"></i> Create Doctor
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- Clinics Modal -->
<div class="modal fade" id="clinicsModal" tabindex="-1" aria-labelledby="clinicsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clinicsModalLabel">Select Clinics</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="clinicSearch" class="form-control mb-2" placeholder="Search clinics..." />
                <div style="max-height:300px;overflow-y:auto;">
                    <ul id="clinicsList" class="list-group">
                        @foreach (var clinic in Model.Clinics ?? Enumerable.Empty<SelectListItem>())
                        {
                            <li class="list-group-item">
                                <input type="checkbox" class="clinic-checkbox" value="@clinic.Value" data-name="@clinic.Text" />
                                @clinic.Text
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveClinicsBtn">Save Selection</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const input   = document.getElementById('photoInput');
            const preview = document.getElementById('photoPreview');
            if (!input || !preview) return;
            input.addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" />';
                };
                reader.readAsDataURL(file);
            });
        })();

        // Clinic search functionality
        document.getElementById('clinicSearch').addEventListener('input', function () {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#clinicsList li').forEach(function (li) {
                var text = li.textContent.toLowerCase();
                li.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        function generateClinicHiddenInputs(containerId, commaFieldId) {
            var selected = [];
            document.querySelectorAll('.clinic-checkbox:checked').forEach(function (cb) {
                selected.push(cb.value);
            });

            var container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = '';
            selected.forEach(function (id) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'ClinicIds';
                inp.value = id;
                container.appendChild(inp);
            });

            var commaInput = document.getElementById(commaFieldId);
            if (commaInput) commaInput.value = selected.join(',');

            // Update selected names display
            var selectedNames = [];
            document.querySelectorAll('.clinic-checkbox:checked').forEach(function (cb) {
                selectedNames.push(cb.getAttribute('data-name'));
            });
            var list = document.getElementById('selectedClinicsList');
            if (list) list.innerHTML = selectedNames.map(function (name) {
                return '<span class="badge bg-primary me-1">' + name + '</span>';
            }).join(' ');
        }

        // Save selected clinics (from modal Save button)
        document.getElementById('saveClinicsBtn').addEventListener('click', function () {
            generateClinicHiddenInputs('ClinicIdsInputs', 'ClinicIdsInput');
            var modal = bootstrap.Modal.getInstance(document.getElementById('clinicsModal'));
            modal.hide();
        });

        // Ensure hidden inputs are present on form submit even if modal wasn't used
        document.getElementById('doctorForm').addEventListener('submit', function () {
            generateClinicHiddenInputs('ClinicIdsInputs', 'ClinicIdsInput');
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
