@model DoctorConnect.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "Appointments";
}

<div class="content-page">
    <div class="page-card">
        <div class="page-card__header">
            <h1 class="page-card__title">Appointments</h1>
        </div>
        <div class="page-card__body">
            <table class="table table-striped datatable" id="appointmentsTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>@a.AppointmentDate.ToShortDateString()</td>
                            <td>@a.AppointmentTime</td>
                            <td>@(a.IsGuestPatient ? a.GuestPatientFullName : a.Patient?.User?.FirstName + " " + a.Patient?.User?.LastName)</td>
                            <td>@a.Status</td>
                            <td>@a.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
