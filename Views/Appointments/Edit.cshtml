@model DoctorConnect.ViewModels.CreateAppointmentViewModel
@{
    ViewData["Title"] = "Edit Appointment";
}
@section styles {
    <link rel="stylesheet" href="~/css/appointment-form.css" />
}
<div class="content-page">
    <div class="page-card">
        <div class="page-card__header">
            <h1 class="page-card__title">Edit <em>appointment</em></h1>
            <span class="apf-header-badge"><i class="fa fa-pen-to-square"></i> Update booking</span>
        </div>
        <div class="page-card__body">
            <form asp-action="Edit" method="post" class="apf-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DoctorId" />
                <div class="apf-section-divider apf-full"><span>Clinic &amp; patient</span></div>
                <div class="apf-field">
                    <label class="apf-label">Clinic</label>
                    @if (Model.Clinics?.Count == 1)
                    {
                        <input class="apf-control" readonly value="@Model.Clinics.First().Text" />
                        <input type="hidden" name="SelectedClinicId" value="@Model.Clinics.First().Value" />
                    }
                    else
                    {
                        <select class="apf-control" asp-for="SelectedClinicId">
                            <option value="">Select clinic</option>
                            @foreach (var c in Model.Clinics)
                            {
                                <option value="@c.Value" selected="@(Model.SelectedClinicId == c.Value ? "selected" : null)">@c.Text</option>
                            }
                        </select>
                    }
                </div>
                <div class="apf-field">
                    <label class="apf-label">Patient type</label>
                    <div class="apf-toggle-wrap">
                        <label class="apf-toggle">
                            <input asp-for="IsGuestPatient" type="checkbox" class="apf-toggle__input" id="isGuest" />
                            <span class="apf-toggle__track"><span class="apf-toggle__thumb"></span></span>
                            <span class="apf-toggle__text">Guest patient</span>
                        </label>
                    </div>
                </div>
                <div class="apf-full" id="existingPatientSection">
                    <div class="apf-field">
                        <label class="apf-label">Patient</label>
                        <div class="apf-patient-row">
                            <input class="apf-control" id="patientSearch" placeholder="Search by name or phone" />
                            <button type="button" class="apf-search-btn" id="openPatientModal">
                                <i class="fa fa-magnifying-glass"></i> Search
                            </button>
                            <input type="hidden" asp-for="PatientId" />
                        </div>
                        <div id="selectedPatient" class="apf-selected-patient">
                            @if (!string.IsNullOrEmpty(Model.PatientId))
                            {
                                <text>Patient loaded</text>
                            }
                        </div>
                    </div>
                </div>
                <div class="apf-full" id="guestSection" style="display:none">
                    <div class="apf-form" style="padding:0">
                        <div class="apf-field">
                            <label class="apf-label">Full name</label>
                            <input class="apf-control" asp-for="GuestPatientFullName" />
                        </div>
                        <div class="apf-field">
                            <label class="apf-label">Phone number</label>
                            <input class="apf-control" asp-for="GuestPatientPhoneNumber" />
                        </div>
                        <div class="apf-field">
                            <label class="apf-label">Gender</label>
                            <select class="apf-control" asp-for="GuestPatientGender">
                                <option value="">Select</option>
                                <option value="1" selected="@(Model.GuestPatientGender == DoctorConnect.Models.Gender.Male ? "selected" : null)">Male</option>
                                <option value="2" selected="@(Model.GuestPatientGender == DoctorConnect.Models.Gender.Female ? "selected" : null)">Female</option>
                                <option value="3" selected="@(Model.GuestPatientGender == DoctorConnect.Models.Gender.Other ? "selected" : null)">Other</option>
                            </select>
                        </div>
                        <div class="apf-field">
                            <label class="apf-label">Date of birth</label>
                            <input type="date" class="apf-control" asp-for="GuestPatientDateOfBirth" />
                        </div>
                    </div>
                </div>
                <div class="apf-section-divider apf-full"><span>Date &amp; time</span></div>
                <div class="apf-full apf-field">
                    <label class="apf-label">Select a date</label>
                    <div id="dateCells" class="date-cells"></div>
                    <input type="date" class="apf-control apf-date-fallback" asp-for="AppointmentDate" id="appointmentDate" />
                </div>
                <div class="apf-full apf-field">
                    <label class="apf-label">Available time slots</label>
                    <div id="slots" class="slots-wrap"></div>
                    <input type="hidden" asp-for="AppointmentTime" />
                </div>
                <div class="apf-section-divider apf-full"><span>Details</span></div>
                <div class="apf-full apf-field">
                    <label class="apf-label">Notes</label>
                    <textarea class="apf-control" asp-for="Notes" placeholder="Optional notes about this appointment"></textarea>
                </div>
                <div class="apf-field">
                    <label class="apf-label">Consultation fee</label>
                    <div class="apf-fee-row">
                        <span class="apf-fee-prefix">$</span>
                        <input class="apf-control" asp-for="Fees" type="number" step="0.01" placeholder="0.00" min="0" />
                    </div>
                </div>
                <div class="apf-field">
                    <label class="apf-label">Status</label>
                    <div class="apf-status-wrap">
                        <label class="status-option @(Model.Status == DoctorConnect.Models.AppointmentStatus.Pending ? "active" : "")" data-value="pending">
                            <input type="radio" name="Status" value="1" @(Model.Status == DoctorConnect.Models.AppointmentStatus.Pending ? "checked" : "") style="display:none" />
                            <i class="fa fa-clock" style="margin-right:5px"></i> Pending
                        </label>
                        <label class="status-option @(Model.Status == DoctorConnect.Models.AppointmentStatus.Confirmed ? "active" : "")" data-value="confirmed">
                            <input type="radio" name="Status" value="2" @(Model.Status == DoctorConnect.Models.AppointmentStatus.Confirmed ? "checked" : "") style="display:none" />
                            <i class="fa fa-circle-check" style="margin-right:5px"></i> Confirmed
                        </label>
                        <label class="status-option @(Model.Status == DoctorConnect.Models.AppointmentStatus.Completed ? "active" : "")" data-value="completed">
                            <input type="radio" name="Status" value="3" @(Model.Status == DoctorConnect.Models.AppointmentStatus.Completed ? "checked" : "") style="display:none" />
                            <i class="fa fa-flag-checkered" style="margin-right:5px"></i> Completed
                        </label>
                        <label class="status-option @(Model.Status == DoctorConnect.Models.AppointmentStatus.Cancelled ? "active" : "")" data-value="cancelled">
                            <input type="radio" name="Status" value="4" @(Model.Status == DoctorConnect.Models.AppointmentStatus.Cancelled ? "checked" : "") style="display:none" />
                            <i class="fa fa-ban" style="margin-right:5px"></i> Cancelled
                        </label>
                        <label class="status-option @(Model.Status == DoctorConnect.Models.AppointmentStatus.NoShow ? "active" : "")" data-value="noshow">
                            <input type="radio" name="Status" value="5" @(Model.Status == DoctorConnect.Models.AppointmentStatus.NoShow ? "checked" : "") style="display:none" />
                            <i class="fa fa-user-xmark" style="margin-right:5px"></i> No-show
                        </label>
                    </div>
                </div>
                <div class="apf-footer">
                    <a class="apf-btn-back" href="javascript:history.back()">
                        <i class="fa fa-arrow-left"></i> Back
                    </a>
                    <button class="apf-btn-save" type="submit">
                        <i class="fa fa-floppy-disk"></i> Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="patientModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="modalPatientSearch" class="apf-control" placeholder="Search by name or phone" style="margin-bottom:.75rem" />
                <div id="patientResults"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function(){
            const isGuest=document.getElementById('isGuest');
            const guestSection=document.getElementById('guestSection');
            const existingSection=document.getElementById('existingPatientSection');
            const patientModal=new bootstrap.Modal(document.getElementById('patientModal'));
            const patientResults=document.getElementById('patientResults');
            const patientSearch=document.getElementById('modalPatientSearch');
            const selectedPatientDiv=document.getElementById('selectedPatient');
            function toggleGuest(){
                if(isGuest.checked){guestSection.style.display='';existingSection.style.display='none';}
                else{guestSection.style.display='none';existingSection.style.display='';}
            }
            isGuest.addEventListener('change',toggleGuest);
            toggleGuest();
            document.querySelectorAll('.status-option').forEach(opt=>{
                opt.addEventListener('click',function(){
                    document.querySelectorAll('.status-option').forEach(o=>o.classList.remove('active'));
                    this.classList.add('active');
                });
            });
            document.getElementById('openPatientModal').addEventListener('click',function(){
                patientSearch.value=document.getElementById('patientSearch').value||'';
                patientResults.innerHTML='';
                patientModal.show();
                searchPatients();
            });
            async function searchPatients(){
                const q=patientSearch.value;
                const res=await fetch('/Appointments/Patients?q='+encodeURIComponent(q));
                const data=await res.json();
                patientResults.innerHTML=data.map(p=>`<div class="patient-item" data-id="${p.id}">${p.text}</div>`).join('');
                document.querySelectorAll('.patient-item').forEach(el=>el.addEventListener('click',function(){
                    document.querySelector('input[name="PatientId"]').value=this.dataset.id;
                    selectedPatientDiv.textContent=this.innerText;
                    patientModal.hide();
                }));
            }
            patientSearch.addEventListener('input',searchPatients);
            async function loadSlots(){
                const doctorId=document.querySelector('input[name="DoctorId"]').value;
                const clinicEl=document.querySelector('select[name="SelectedClinicId"]')||document.querySelector('input[name="SelectedClinicId"]');
                const clinicId=clinicEl?.value;
                const dateEl=document.getElementById('appointmentDate');
                if(!doctorId||!clinicId||!dateEl.value)return;
                const res=await fetch(`/Appointments/Slots?doctorId=${encodeURIComponent(doctorId)}&clinicId=${encodeURIComponent(clinicId)}&date=${encodeURIComponent(dateEl.value)}`);
                const json=await res.json();
                const slotsDiv=document.getElementById('slots');
                slotsDiv.innerHTML='';
                json.slots.forEach(s=>{
                    const btn=document.createElement('button');
                    btn.type='button';
                    btn.className='slot-btn';
                    btn.textContent=formatTime(s.time);
                    if(s.available){
                        btn.addEventListener('click',function(){
                            document.querySelector('input[name="AppointmentTime"]').value=s.time;
                            document.querySelectorAll('.slot-btn').forEach(b=>b.classList.remove('active'));
                            btn.classList.add('active');
                        });
                    } else {
                        btn.disabled=true;
                    }
                    slotsDiv.appendChild(btn);
                });
            }
            function formatTime(ts){
                if(!ts)return'';
                const p=ts.split(':');
                return p[0]+':'+p[1];
            }
            const dateCellsDiv=document.getElementById('dateCells');
            const appointmentDateInput=document.getElementById('appointmentDate');
            const clinicSelect=document.querySelector('select[name="SelectedClinicId"]');
            const doctorId=document.querySelector('input[name="DoctorId"]').value;
            const initialDate='@Model.AppointmentDate.ToString("yyyy-MM-dd")';
            async function loadDateCells(){
                const clinicIdVal=clinicSelect?clinicSelect.value:document.querySelector('input[name="SelectedClinicId"]')?.value;
                dateCellsDiv.innerHTML='';
                if(!clinicIdVal||!doctorId)return;
                try{
                    const res=await fetch(`/Appointments/AvailableDates?doctorId=${encodeURIComponent(doctorId)}&clinicId=${encodeURIComponent(clinicIdVal)}`);
                    if(!res.ok)return;
                    const data=await res.json();
                    if(!Array.isArray(data))return;
                    data.forEach(d=>{
                        const cell=document.createElement('div');
                        cell.className='date-cell';
                        cell.dataset.date=d.date;
                        cell.innerHTML=`<div class="day">${d.day}</div><div class="num">${d.dayNumber}</div>`;
                        cell.addEventListener('click',function(){
                            appointmentDateInput.value=this.dataset.date;
                            markActiveCell(this.dataset.date);
                            loadSlots();
                        });
                        dateCellsDiv.appendChild(cell);
                    });
                    if(initialDate)markActiveCell(initialDate);
                }catch(e){console.error(e);}
            }
            function markActiveCell(dateStr){
                document.querySelectorAll('#dateCells .date-cell').forEach(c=>c.classList.remove('active'));
                const sel=document.querySelector(`#dateCells .date-cell[data-date="${dateStr}"]`);
                if(sel)sel.classList.add('active');
            }
            if(clinicSelect)clinicSelect.addEventListener('change',function(){loadDateCells();setTimeout(loadSlots,200);});
            appointmentDateInput.addEventListener('change',function(){markActiveCell(this.value);loadSlots();});
            loadDateCells().then(()=>{
                if(initialDate&&document.querySelector(`#dateCells .date-cell[data-date="${initialDate}"]`)){
                    appointmentDateInput.value=initialDate;
                    markActiveCell(initialDate);
                }
                loadSlots();
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
