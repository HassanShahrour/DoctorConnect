@model DoctorConnect.ViewModels.ServiceManagementViewModel
@{
    ViewData["Title"] = $"{Model.OwnerType} Services";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
}
<div class="svc-page">
    <section class="svc-hero">
        <div>
            <span class="svc-hero__eyebrow">@Model.OwnerType management</span>
            <h1 class="svc-hero__title">@Model.OwnerName <em>Services</em></h1>
            <p class="svc-hero__subtitle">Manage available services, pricing, and active status in one place.</p>
        </div>
        <button type="button" class="svc-btn svc-btn--primary" data-bs-toggle="modal" data-bs-target="#createServiceModal">
            <i class="fa fa-plus"></i> Add service
        </button>
    </section>
    @Html.AntiForgeryToken()
    @if (Model.Services.Any())
    {
        <section class="svc-grid">
            @foreach (var service in Model.Services)
            {
                <article class="svc-card">
                    <div class="svc-card__header">
                        <div>
                            <h3 class="svc-card__title">@service.Name</h3>
                            <span class="svc-badge @(service.IsActive ? "svc-badge--active" : "svc-badge--inactive")">
                                @(service.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="svc-card__price">
                            @(service.Fees.HasValue ? $"${service.Fees.Value:0.##}" : "—")
                        </div>
                    </div>
                    <p class="svc-card__description">
                        @(string.IsNullOrWhiteSpace(service.Description) ? "No description provided for this service yet." : service.Description)
                    </p>
                    <div class="svc-card__footer">
                        <button type="button"
                                class="svc-btn svc-btn--edit svc-edit-btn"
                                data-id="@service.Id"
                                data-name="@service.Name"
                                data-description="@service.Description"
                                data-fees="@service.Fees"
                                data-isactive="@service.IsActive.ToString().ToLower()"
                                data-bs-toggle="modal"
                                data-bs-target="#editServiceModal">
                            <i class="fa fa-pen-to-square"></i> Edit
                        </button>
                        <form asp-action="Delete" asp-controller="Services" method="post" class="svc-delete-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@service.Id" />
                            <input type="hidden" name="doctorId" value="@(Model.OwnerType == "Doctor" ? Model.OwnerId : null)" />
                            <input type="hidden" name="clinicId" value="@(Model.OwnerType == "Clinic" ? Model.OwnerId : null)" />
                            <button type="submit"
                                    class="svc-btn svc-btn--delete sweet-confirm"
                                    data-confirm-title="Delete service?"
                                    data-confirm-text="This service will be permanently removed.">
                                <i class="fa fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <section class="svc-empty">
            <div class="svc-empty__icon"><i class="fa fa-briefcase-medical"></i></div>
            <h3>No services yet</h3>
            <p>Start by adding the first service for this @Model.OwnerType.ToLower().</p>
        </section>
    }
</div>
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content svc-modal">
            <form asp-action="Create" asp-controller="Services" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="ClinicId" />
                <div class="modal-header svc-modal__header">
                    <h5 class="modal-title">Add service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body svc-modal__body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Initial consultation" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of what this service includes…"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Fees" class="form-label"></label>
                        <input asp-for="Fees" class="form-control" placeholder="0.00" type="number" step="0.01" />
                        <span asp-validation-for="Fees" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer svc-modal__footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save service</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content svc-modal">
            <form asp-action="Edit" asp-controller="Services" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" id="editServiceId" />
                <input asp-for="DoctorId" type="hidden" />
                <input asp-for="ClinicId" type="hidden" />
                <div class="modal-header svc-modal__header">
                    <h5 class="modal-title">Edit service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body svc-modal__body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" id="editServiceName" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" id="editServiceDescription"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Fees" class="form-label"></label>
                        <input asp-for="Fees" class="form-control" id="editServiceFees" type="number" step="0.01" />
                        <span asp-validation-for="Fees" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" id="editServiceIsActive" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer svc-modal__footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update service</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.svc-edit-btn').forEach(btn=>{
            btn.addEventListener('click',function(){
                document.getElementById('editServiceId').value=this.dataset.id||'';
                document.getElementById('editServiceName').value=this.dataset.name||'';
                document.getElementById('editServiceDescription').value=this.dataset.description||'';
                document.getElementById('editServiceFees').value=this.dataset.fees||'';
                document.getElementById('editServiceIsActive').checked=this.dataset.isactive==='true';
            });
        });
    </script>
}
